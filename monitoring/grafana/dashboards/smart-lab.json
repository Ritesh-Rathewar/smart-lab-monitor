  {
   "id": 9,
   "type": "state-timeline",
   "title": "Predicted status per machine (0 Normal, 1 Warning, 2 Critical)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_predicted_status",
     "legendFormat": "{{machine}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Normal",
         "color": "green"
        },
        "1": {
         "text": "Warning",
         "color": "orange"
        },
        "2": {
         "text": "Critical",
         "color": "red"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "legend": {
     "showLegend": false
    }
   }
  },
